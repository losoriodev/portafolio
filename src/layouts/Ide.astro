---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { ui, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props { lang: Lang; title?: string; description?: string }
const { lang, title = `${profile.name} — ${profile.role[lang]}`, description = profile.tagline[lang] } = Astro.props;
const s = ui[lang];

// Cada entrada es una sección real de la página: tabs y sidebar apuntan a anchors que existen.
const sections = [
  { id: 'home', file: 'home.tsx', icon: 'home', color: 'var(--accent)', ext: 'TSX' },
  { id: 'about', file: 'about_me.md', icon: 'user', color: 'var(--cyan)', ext: 'MD' },
  { id: 'experience', file: 'experience.json', icon: 'briefcase', color: 'var(--purple)', ext: 'JSON' },
  { id: 'projects', file: 'projects.json', icon: 'folder', color: 'var(--green)', ext: 'JSON' },
  { id: 'skills', file: 'skills.ts', icon: 'zap', color: 'var(--accent)', ext: 'TS' },
  { id: 'certs', file: 'certifications.json', icon: 'award', color: 'var(--cyan)', ext: 'JSON' },
  { id: 'contact', file: 'contact.sh', icon: 'mail', color: 'var(--green)', ext: 'SH' },
] as const;

const lines = Array.from({ length: 60 }, (_, i) => i + 1);
const altPath = lang === 'es' ? '/en/' : '/';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="es" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role[lang]}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Pixelify+Sans:wght@500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Evita el flash de tema: aplica el tema guardado antes del primer paint.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || (!t && matchMedia('(prefers-color-scheme: light)').matches)) {
          document.documentElement.dataset.theme = 'light';
        }
      } catch {}
    </script>
  </head>
  <body class="h-screen overflow-hidden flex flex-col font-sans" data-ext={JSON.stringify(Object.fromEntries(sections.map((x) => [x.id, x.ext])))} data-files={JSON.stringify(Object.fromEntries(sections.map((x) => [x.id, x.file])))}>
    <!-- Title bar -->
    <header class="h-10 bg-titlebar border-b border-border flex items-center px-4 shrink-0 select-none">
      <div class="flex gap-2" aria-hidden="true">
        <span class="w-3 h-3 rounded-full bg-red/80"></span>
        <span class="w-3 h-3 rounded-full bg-accent/80"></span>
        <span class="w-3 h-3 rounded-full bg-green/80"></span>
      </div>
      <p class="flex-1 text-center font-mono text-xs text-dim truncate px-4">{profile.handle}@portfolio — <span id="status-file">{sections[0].file}</span></p>
      <div class="flex items-center gap-3">
        <button id="theme-toggle" type="button" class="focus-ring text-dim hover:text-text transition-colors p-1" aria-label={s.toggleTheme} title={s.toggleTheme}>
          <span class="dark-only"><Icon name="sun" /></span>
          <span class="light-only"><Icon name="moon" /></span>
        </button>
        <a href={altPath} class="focus-ring font-mono text-xs tracking-wide" aria-label={s.switchLang} title={s.switchLang}>
          <span class={lang === 'es' ? 'text-text font-bold' : 'text-dim'}>ES</span>
          <span class="text-muted"> / </span>
          <span class={lang === 'en' ? 'text-text font-bold' : 'text-dim'}>EN</span>
        </a>
      </div>
    </header>

    <div class="flex flex-1 min-h-0">
      <!-- Sidebar / explorer: solo enlaces reales a secciones -->
      <nav class="hidden lg:flex w-64 shrink-0 bg-sidebar border-r border-border flex-col py-3 overflow-y-auto" aria-label="Explorer">
        <p class="px-4 font-mono text-[11px] tracking-widest text-dim mb-2 flex items-center gap-1"><Icon name="chevron" size={12} /> {s.explorer}</p>
        <p class="px-4 font-mono text-sm text-text flex items-center gap-2 mb-1"><Icon name="chevron" size={12} class="text-dim" /><Icon name="folder" size={14} class="text-dim" /> portfolio</p>
        <ul class="flex flex-col">
          {sections.map((sec) => (
            <li>
              <a href={`#${sec.id}`} data-nav={sec.id} class="nav-item focus-ring flex items-center gap-2 pl-9 pr-4 py-1.5 font-mono text-sm transition-colors">
                <Icon name={sec.icon} size={14} class="shrink-0" style={`color:${sec.color}`} />
                {sec.file}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-auto px-4 pt-4 border-t border-border-2 font-mono text-xs text-dim flex flex-col gap-1.5">
          <a href={profile.linkedin} target="_blank" rel="noopener" class="focus-ring flex items-center gap-2 hover:text-text"><Icon name="linkedin" size={14} /> LinkedIn</a>
          <a href={`mailto:${profile.email}`} class="focus-ring flex items-center gap-2 hover:text-text"><Icon name="mail" size={14} /> {profile.email}</a>
        </div>
      </nav>

      <div class="flex-1 min-w-0 min-h-0 flex flex-col">
        <!-- Tabs: cada tab navega a su sección. Sin "X": nada que parezca clicable sin serlo. -->
        <nav class="bg-tabbar border-b border-border flex overflow-x-auto shrink-0 [scrollbar-width:none]" aria-label="Sections">
          {sections.map((sec) => (
            <a href={`#${sec.id}`} data-tab={sec.id} class="tab focus-ring flex items-center gap-2 px-4 h-10 font-mono text-[13px] transition-colors">
              <span class="w-2 h-2 rounded-full shrink-0" style={`background:${sec.color}`} aria-hidden="true"></span>
              {sec.file}
            </a>
          ))}
        </nav>

        <div id="editor" class="flex flex-1 min-h-0 editor-bg overflow-y-auto">
          <!-- Line gutter (decorativo) -->
          <div class="hidden md:block w-12 shrink-0 border-r border-border-2 sticky top-0 self-start h-full overflow-hidden select-none" aria-hidden="true">
            <ol class="font-mono text-[13px] text-ln text-right pr-3 pt-8 leading-[1.55rem]">
              {lines.map((n) => <li>{n}</li>)}
            </ol>
          </div>
          <main class="flex-1 min-w-0 px-5 sm:px-8 lg:px-14 xl:px-20 pb-24">
            <slot />
          </main>
        </div>
      </div>
    </div>

    <!-- Status bar -->
    <footer class="h-7 bg-accent text-[#0b0e14] font-mono text-[11px] font-semibold flex items-center px-3 gap-4 shrink-0">
      <span>⎇ main</span>
      <span>✓ 0 errors</span>
      <span class="hidden sm:inline">⚡ Astro</span>
      <span class="hidden sm:inline">◆ {s.statusTheme}</span>
      <span class="ml-auto hidden sm:inline">UTF-8</span>
      <span id="status-ext">TSX</span>
      <span>{profile.name}</span>
    </footer>

    <style>
      :root:not([data-theme="light"]) .light-only { display: none; }
      :root[data-theme="light"] .dark-only { display: none; }
    </style>

    <script>
      // Tema
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        if (next === 'light') root.dataset.theme = 'light'; else delete root.dataset.theme;
        try { localStorage.setItem('theme', next); } catch {}
      });

      // Scroll-spy: resalta tab + item del explorador y actualiza la barra de estado.
      const ext: Record<string, string> = JSON.parse(document.body.dataset.ext ?? '{}');
      const statusExt = document.getElementById('status-ext');
      const statusFile = document.getElementById('status-file');
      const files: Record<string, string> = JSON.parse(document.body.dataset.files ?? '{}');
      const setActive = (id: string) => {
        document.querySelectorAll<HTMLElement>('[data-tab],[data-nav]').forEach((el) => {
          const match = (el.dataset.tab ?? el.dataset.nav) === id;
          el.setAttribute('aria-current', String(match));
          if (match && el.dataset.tab) el.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        });
        if (statusExt && ext[id]) statusExt.textContent = ext[id];
        if (statusFile && files[id]) statusFile.textContent = files[id];
      };
      const io = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) setActive(visible.target.id);
        },
        { root: document.getElementById('editor'), rootMargin: '-15% 0px -65% 0px', threshold: [0, 0.1, 0.5] },
      );
      document.querySelectorAll('main section[id]').forEach((sec) => io.observe(sec));
      setActive(location.hash.slice(1) || 'home');
    </script>
  </body>
</html>
