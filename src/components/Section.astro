---
import Icon from './Icon.astro';
interface Props { id: string; title: string; icon: any; class?: string }
const { id, title, icon, class: cls = '' } = Astro.props;
---
<section id={id} class={`pt-16 scroll-mt-12 ${cls}`}>
  <h2 class="section-title mb-8"><Icon name={icon} size={26} /> {title}</h2>
  <slot />
</section>
